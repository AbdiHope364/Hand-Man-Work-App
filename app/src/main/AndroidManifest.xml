<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HandManWork"
        tools:targetApi="31">

        <!-- Login Activity (LAUNCHER) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.HandManWork">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register Activity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- User Type Selection -->
        <activity
            android:name=".UserTypeSelectionActivity"
            android:exported="false" />

        <!-- Customer Activities -->
        <activity
            android:name=".CustomerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".CustomerProfileActivity"
            android:exported="false" />
        <activity
            android:name=".CustomerDashboardActivity"
            android:exported="false" />

        <!-- Worker Activities -->
        <activity
            android:name=".WorkerProfileActivity"
            android:exported="false" />
        <activity
            android:name=".HandymanDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".WorkerDashboardActivity"
            android:exported="false" />

        <!-- Booking Activity -->
        <activity
            android:name=".BookingActivity"
            android:exported="false" />

        <!-- Setup Data Activity (temporary) -->
        <activity
            android:name=".SetupDataActivity"
            android:exported="false" />

        <!-- Main Activity (if still needed) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>