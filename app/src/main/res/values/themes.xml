<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.HandManWork" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#333333</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand colors -->
        <item name="colorSecondary">#000000</item>
        <item name="colorSecondaryVariant">#333333</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        
        <!-- Text colors -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">#666666</item>
        
        <!-- Dialog Themes for Calendar/Time Picker -->
        <item name="android:datePickerDialogTheme">@style/CustomPickerTheme</item>
        <item name="android:timePickerDialogTheme">@style/CustomPickerTheme</item>
        
        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.MaterialComponents.Button</item>
        
        <!-- TextInputLayout styles -->
        <item name="textInputStyle">@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox</item>
    </style>

    <!-- High-Contrast Picker Theme -->
    <style name="CustomPickerTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">#000000</item> <!-- Header Background -->
        <item name="colorAccent">#000000</item> <!-- Selection Color -->
        <item name="android:textColorPrimary">#000000</item> <!-- Body Text -->
        <item name="android:textColorSecondary">#666666</item> <!-- Subtitle Text -->
        <item name="android:headerBackground">#000000</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PickerButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/PickerButtonStyle</item>
    </style>

    <style name="PickerButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#000000</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.HandManWork.Splash" parent="Theme.HandManWork">
        <item name="android:windowBackground">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
